{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Bezalel",
  "version": "0.2.2",
  "identifier": "app.bezalel.launcher",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{
      "label": "main",
      "title": "Bezalel",
      "width": 1180,
      "height": 770,
      "minWidth": 750,
      "minHeight": 540,
      "center": true
    }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost; object-src 'none'; frame-src 'none'; base-uri 'none'; form-action 'none'",
      "capabilities": ["desktop"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "../builder/": "builder/" }
  }
}
